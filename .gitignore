.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── AI assistant ────────────────────────────────────────────────────────
.claude/

# ── Snapshot backups (snapshot_gui.py output, full project copies) ──────
.snapshot/

# ── Dev-only scripts (keep local, not for distribution) ────────────────
snapshot_gui.py
open_claude.py
cns_scanner.py
chinese_in_cpp.txt
ve_build_check.bat

# ── imgui-node-editor: only the core files the engine compiles are kept ─
VostaEngine/thirdparty/imgui-node-editor/examples/
VostaEngine/thirdparty/imgui-node-editor/external/
VostaEngine/thirdparty/imgui-node-editor/.github/
VostaEngine/thirdparty/imgui-node-editor/docs/

# ── Editor runtime artifacts (regenerated on launch, written to cwd) ────
_mesh_thumb_default.veasset
sphere_initialShadingGroup.veasset
cube_default.veasset
n.veasset
s.veasset
fountain_taobaodianpu_CFSC194SG.veasset
default.veasset
SandBox/e.veasset

# Materials baked next to the built-in meshes on launch (engine-owned dir)
SandBox/assets/models/*.veasset
VostaEditor/assets/models/*.veasset

# ── Engine temp resources (transient, not for distribution) ─────────────
VostaEngine/resources/temps/

# ── Third-party / unknown-origin assets (private, not for distribution) ──
# Quarantined here so they never get committed. Origin/license unverified.
ThirdPartyResources/

# ── Legacy SandBox test scenes (reference quarantined assets, would not load) ──
SandBox/assets/scenes/

# ── SandBox content (locally imported assets, not for distribution) ─────
SandBox/content/

# ── Local project roots (per-machine: Projects/<name>/project.json + content) ──
Projects/

# ── Editor session state (machine-generated, not for distribution) ──────
/Saved/
SandBox/Saved/

# ── Stray nested build/artifact dir ────────────────────────────────────
SandBox/SandBox/

# ── Built game module (host loads <projectRoot>/Binaries/game.dll) ──────
SandBox/Binaries/

# ── nlohmann/json (vendored): only what the engine builds against ───────
VostaEngine/thirdparty/JSON/*
!VostaEngine/thirdparty/JSON/include/
!VostaEngine/thirdparty/JSON/LICENSE.MIT
!VostaEngine/thirdparty/JSON/LICENSES/

# ── Engine-owned mesh files (the *.obj rule above is for compiler outputs) ──
!SandBox/assets/models/sphere.obj
!SandBox/assets/models/cube.obj
!VostaEditor/assets/models/sphere.obj

# ── Athenaeum knowledge-base CLI (local-only tool, not for distribution) ──
ath.py
